    'switch')
      globals=0
      opts=(
        '(-h --help)'{-h,--help}'[Output usage information]'
        '(-v --version)'{-v,--version}'[Output the version number]'
        '--cwd=[Sets the current working directory for a single run of a command]:DIR:_files -/'
