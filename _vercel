      args=('::name: ')
      ;;
  esac
}

# _arguments leaves the "--" separator in front of the wrapped command line.
_vercel_command() {
  if [[ $words[1] == -- ]]; then
    shift words
    (( CURRENT-- ))
  fi
  _normal
}

_vercel_globals() {
  global_opts=(
    '(-h --help)'{-h,--help}'[Output usage information]'
    '(-v --version)'{-v,--version}'[Output the version number]'
    '--cwd=[Sets the current working directory for a single run of a command]:DIR:_files -/'
    '(-A --local-config)'{-A+,--local-config=}'[Path to the local `vercel.json` file]:FILE:_files'
    '(-Q --global-config)'{-Q+,--global-config=}'[Path to the global `.vercel` directory]:DIR:_files -/'
    '(-d --debug)'{-d,--debug}'[Debug mode (default off)]'
    '--no-color[No color mode (default off)]'
    '--non-interactive[Run without interactive prompts; when an agent is detected this is the default]'
    '(-S --scope)'{-S+,--scope=}'[Set a custom scope]:scope: '
    '(-t --token)'{-t+,--token=}'[Login token]:TOKEN: '
  )
}

_vercel_load() {
  local spec flag
  _vercel_node "$node"
  (( globals )) && opts+=($global_opts)
  alias_of=($alias_pairs)
  value_flags=()
  for spec in $opts; do
    spec=${spec#\(*\)}
    flag=${${spec#\*}%%[\[:]*}
    [[ $flag == *[=+] ]] && value_flags+=(${flag%[=+]})
  done
}

_vercel() {
  local curcontext=$curcontext state state_descr line node word
  local -a subs alias_pairs opts args value_flags global_opts expl
  local -A opt_args alias_of
  local -i globals skip i=2 start=1 positional=0 ret=1

  _vercel_globals
  _vercel_load
  while (( i < CURRENT )); do
    word=$words[i]
    if [[ $word == -- ]]; then
      break
    elif [[ $word == -?* ]]; then
      [[ $word != *=* ]] && (( $value_flags[(Ie)$word] )) && (( i++ ))
    elif (( skip > 0 )); then
      (( skip-- ))
    elif (( ! positional )); then
      word=${alias_of[$word]:-$word}
      if [[ -z $node && $word == help ]]; then
        start=$i
      elif (( $subs[(I)${(b)word}:*] )); then
        node="${node:+$node }$word"
        start=$i
        _vercel_load
      else
        positional=1
      fi
    fi
    (( i++ ))
  done

  words=($words[1] "${(@)words[start+1,-1]}")
  (( CURRENT -= start - 1 ))

  _arguments -s -S -C : $opts $args && ret=0
  if [[ $state == command ]]; then
    _describe -t commands 'vercel command' subs && ret=0
    if [[ -z $node && $PREFIX == [./~]* ]]; then
      _wanted directories expl 'project path' _path_files -/ && ret=0
    fi
  fi
  return ret
}

_vercel "$@"
